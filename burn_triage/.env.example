# Copy to .env and edit.

# --- Option A: local Hugging Face transformers (default; works on CPU, faster on GPU) ---
QWEN_BACKEND=transformers
QWEN_MODEL=Qwen/Qwen3-1.7B            # Qwen/Qwen3-4B or Qwen/Qwen3-8B if you have a GPU
QWEN_VL_MODEL=Qwen/Qwen3-VL-2B-Instruct   # empty = no photo analysis
# HF_HUB_OFFLINE=1                    # after the first download

# --- Option B: any OpenAI-compatible server hosting Qwen3 ---
# Ollama:   ollama pull qwen3:4b && ollama pull qwen3-vl:4b
# QWEN_BACKEND=openai
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_API_KEY=ollama
# QWEN_MODEL=qwen3:4b
# QWEN_VL_MODEL=qwen3-vl:4b
#
# vLLM:     vllm serve Qwen/Qwen3-8B   -> QWEN_BASE_URL=http://localhost:8000/v1 (run this app on another port)
# DashScope (Alibaba Cloud): QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1, QWEN_MODEL=qwen3-8b

# --- Option C: rules only, no LLM (offline demo / tests) ---
# QWEN_BACKEND=none

# pending = trust Qwen only for the question just asked (small models); full = trust everything (4B+)
LLM_TRUST=pending
# Devanagari replies for Devanagari callers: auto | on | off
LOCALIZE_REPLIES=auto
EMERGENCY_NUMBER=108
